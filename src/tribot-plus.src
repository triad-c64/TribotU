/*********************************************************
 *     coded by Adder of Triad in 2026 for X2026         *
 *********************************************************/
#import "tokenize.src"
#import "keyboard.src"
#import "embedder.src"
#import "extract.src"
#import "phrases.src"

.pc = $0801 "Basic Upstart"
BasicUpstart(PROGRAMM) 
 
.pc = PROGRAMM "TRIBOT ULTIMATE"
          
          sei
          lda #$7f
          sta $dc0d

          lda #$35
          sta $01
          
          lda #$ff
          cmp $d012
          bne *-3
          lda #$01
          cmp $d012
          bne *-3
          lda #0
          cmp $d012
          bne *-3

          lda #0
          sta $d020
          sta $d021
           
          jsr Init
REU_CHECK:
          jsr checkForREU                    // prüfen ob eine REU vorhanden ist
          cpx #0
          beq REU_CHECK
          
          jsr Init
          jsr CleanUp

          ldx #0
PROMPT:
          lda prompt    ,x
          beq SetNMI
          sta SCREEN - 2,x
          inx
          bne PROMPT
SetNMI:
          lda #<nmi
          sta $fffa
          lda #>nmi
          sta $fffb
         
          lda #<irq
          sta $fffe
          lda #>irq
          sta $ffff

          lda #$a1
          sta $d012
          lda #$1b
          sta $d011
          lda #1
          sta $d019
          sta $d01a
          cli
botloop:   
          jsr Input
          
          lda #1
          sta stop_input
  
          ldx #0
setQuery:
          lda SCREEN,x
          cmp #63 // fragezeichen
          beq finalize_query
sta_input:
          sta string1,x
          inx
          bne setQuery
          
finalize_query:
          lda #$00
          sta string1,x
          stx len1
         
          sei
          jsr ShortPhrase
          jsr ExtractString
          
          jsr worker 
          cli
ready:
          jmp botloop                                
                      // zurück
stop_input:
 .byte 0
// ****************************************************************************************
irq: 
         pha
         txa
         pha
         tya
         pha
  
         lda #$9f
         cmp $d012
         bne *-3
     
         lda stop_input
         bne returnIrq
   
         jsr if6bc

         lda keyblock 
         beq NormalizedInput

         lda #0
         sta keyblock

NormalizedInput:
         lda inputdone
         bne returnIrq

         inc frame
         lda frame
         cmp #10
         bne returnIrq
        
         lda cursor
         eor #$1
         sta cursor
         
         beq ClearCursor
            
         ldy keypos
         lda #100
         sta SCREEN   ,y
         jmp SetKeyboardBack
ClearCursor:
         ldy keypos
         lda #$20
         sta SCREEN   ,y
SetKeyboardBack:
         lda #0
         sta frame
         sta keyflag
         sta lastkey
        
returnIrq: 
       
         lda #$9e
         sta $d012
         asl $d019
         
         pla
         tay
         pla
         tax
         pla

         rti

// ************************************
// ** Worker                         **7
// ************************************
worker: 
          jsr save_eliza_input_string
          jsr PlotQuestions
          jsr tokenize
          jsr Embeddings
          jsr start_check
          rts

start_check:
  
GETNODES:
          lda reubank
          sta REUBANK
          lda reuram
          sta REURAM + 1

          lda #REU_FETCH_A__           // Befehl fürs Kopieren von der REU zum C64
          sta REUCOMMAND               // mit AUTOLOAD ausführen
           
          jsr cosine_approximation
          cpx #DIM                     // in x - register dot product
          bne check_dist
    
          stx dist0
          // found direct hit
          lda reubank
          sta bestBank 
          lda reuram
          sta bestram
          jmp MatchFound
   
diff_bne:  // help jmp
          jmp GETNODES

check_dist:
          cpx dist0
          bcc continue_iterative_search      // carry=1 → a >= b → hier: größer
update_founded:
          stx dist0

set_latest_entry:
          lda reubank
          sta bestBank 
          lda reuram
          sta bestram
  
continue_iterative_search:
          lda reuram
          cmp COUNT_ENTRIES_LO
          beq check_bank
          inc reuram
          bne diff_bne
          inc reubank
          bne diff_bne
          jmp check_founded
check_bank:
          lda reubank
          cmp COUNT_ENTRIES_HI
          beq check_founded
          inc reuram
          bne diff_bne
          inc reubank
          bne diff_bne
          
check_founded:
          lda bestram
          bne MatchFound
          lda bestBank
          bne MatchFound

MatchFound: 
          ldx dist0
          cpx #ELIZA_THRESHOLD
          bcc Ask_ELIZA
          //*/

          lda bestBank
          sta REUBANK
          lda bestram
          sta REURAM + 1

          lda #REU_FETCH_A__           // Befehl fürs Kopieren von der REU zum C64
          sta REUCOMMAND               // mit AUTOLOAD ausführen
PlotAnswer:
          jsr PlotAlignedLines
          jsr Init
          rts

Ask_ELIZA:
          jsr ELIZA
          jsr Plot_ELIZA_ANSWER
          jsr Init
          rts

CleanUp:
          ldx #0
       
GetLoadLookup:
          lda LoadTab        ,x
SetLookup:
          sta lookUpx127Lo   ,x
          inx  
          bne GetLoadLookup
          inc GetLoadLookup  + 2
          inc SetLookup      + 2
          lda GetLoadLookup  + 2
          cmp #$35
          bne GetLoadLookup
          rts

Init:
          lda #0
          sta keypos
          sta keyflag
          sta keyblock
          sta reuram
          sta reubank
          sta bestBank
          sta bestram
          sta REUBANK                     // 1. Bank (lfd.-Nr. 0)
          sta REURAM                      // und beginnen auch direkt ab Adresse $0000
          sta REURAM+1                    // in der Bank
          sta frame                      
          sta inputdone            
          sta cursor 
          sta stop_input
          sta key_return
          sta musicplay
          sta dist0
          sta check_summe
          sta scroll_pos
          sta scroll_pos + 1
          sta lines_scrolled

          lda #<DATARAM                      // Beginn des Speichers der  
          sta REUC64RAM                      // REU als C64-Speicherbereich mitteilen
          lda #>DATARAM
          sta REUC64RAM+1

          lda #<($0100)                      // Die Anzahl der BYTEs ($0100)
          sta REUBYTES                       // je Aktion der REU bekannt machen
          lda #>($0100)
          sta REUBYTES+1

          ldx #0     
cls_input:
          lda #$20
          sta SCREEN  ,x
          inx 
          cpx #MAXLENGHT
          bne cls_input

          ldx #0
          lda #0
cls_input_strings:
          sta input   ,x
          sta string1 ,x
          sta correct ,x
          inx
          bne cls_input_strings
          rts

save_eliza_input_string:
          ldx #0
eliza_string_save:
          lda string1, x
          sta string2, x
          inx
          cpx #40
          bne eliza_string_save
          rts
               
prompt:
   .text "> "
   .byte 0
nmi: 
    rti  
