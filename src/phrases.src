#import "variables.src"

.pc = Phrases "shorten phrases"
ShortPhrase:
        
        ldx #$0
        stx count_phrases

        lda #>phrases
        sta phrase  + 2
        lda #<phrases
        sta phrase  + 1

phrase:
        lda phrases,        x
        beq equal_phrases
compare_string:
        cmp string1,        x
        bne unequal_phrase
        inx 
        cpx #29
        bne phrase
        jmp unequal_phrase

equal_phrases:
        ldy #0
set_new_question:
        lda string1,         x
        sta string1,         y
        beq return_from_phrases
        inx
        iny
        jmp set_new_question

unequal_phrase:
        lda phrase        + 1
        clc
        adc #29
        sta phrase        + 1
        lda phrase        + 2
        adc #0
        sta phrase        + 2

        inc count_phrases
        lda count_phrases
        cmp #NUMBEROFPHRASES
        beq ret_from_phrases
        ldx #0
        jmp phrase

return_from_phrases:
        sty len1
ret_from_phrases:
        rts

count_phrases:
 .byte 0

phrases:
.text "tell me a joke about @       "
.text "what is an @                 "
.text "what if @                    "
.text "name some @                  "
.text "name @                       "
.text "what is a @                  "
.text "what is the deal with @      "
.text "whats the deal with @        "
.text "what is meant by @           "
.text "what is the definition of @  "
.text "what constitutes an @        "
.text "what constitutes a @         "
.text "what constitutes @           "
.text "how would you describe an @  "
.text "how would you describe a @   "
.text "how would you describe @     "
.text "what can be described as @   "
.text "what is going on with an @   "
.text "what is going on with a @    "
.text "what is going on with @      "
.text "whats going on with @        "
.text "can you explain @            "
.text "can you tell me about @      "
.text "define the @                 "
.text "define a @                   "
.text "explain what is @            "
.text "explain who is @             "
.text "explain @                    "
.text "what do you know about @     "
.text "whats can you tell me about @"
.text "give me info on @            "
.text "give me information on @     "
.text "give me info about @         "
.text "give me information about @  "
.text "what would you call @        "
.text "tell me what is @            "
.text "what was @                   "
.text "tell me who is @             "
.text "describe who is @            "
.text "who was @                    "
.text "do you know @                "
.text "have you heard of @          "
.text "is there a @                 "
