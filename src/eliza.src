 *********************************************************/
#import "variables.src"
#import "image_routines.src"

.pc = ELIZA "ELIZA"
        lda #0
        sta eliza_entries     + 1
        lda #<final_answer 
        sta out_answer_e      + 1
        sta out_answer_n      + 1
        sta clean_rest_answer + 1

        lda #>final_answer 
        sta out_answer_e      + 2
        sta out_answer_n      + 2
        sta clean_rest_answer + 2

        ldx #0 
clean_up_final_eliza_answer:
        lda #$20
        sta final_answer      ,x
        lda #$00
        sta EXTRACTED_ELIZA   ,x
        inx
        bne clean_up_final_eliza_answer
        
        lda #$90               // OFFSET ELIZA
        sta REUBANK
eliza_entries:
        lda #0
        sta REURAM + 1

        lda #REU_FETCH_A__            
        sta REUCOMMAND                
            
        jsr GetResponse

        lda eliza_answer
        bne cnup
        inc eliza_entries + 1
        lda eliza_entries + 1 
        cmp ELIZA_ENTRIES
        bne eliza_entries
          
        lda eliza_answer
        beq fallback_eliza

        jmp cnup
fallback_eliza:
         
        ldy #$00
copy_fallback:
        lda fallback,y
        sta final_answer,y
        beq cnup
        iny
        jmp copy_fallback
cnup:
        rts


matches:
        ldx #0          

search_loop:
        lda input_eliza       ,x
        beq quit_w_no_match     
        ldy #0                 
match_pattern:
        lda DATARAM           ,y
        // beq pattern_matched    
        cmp #$30                   // auf '0' prüfen
        beq pattern_matched
        lda input_eliza       ,x
        cmp DATARAM           ,y
        bne next_char
        iny
        inx
        jmp match_pattern

pattern_matched:
        ldy #0
copy_rest:
        lda input_eliza       ,x
        beq return_from_extr
        cmp #' '
        beq return_from_extr
        sta EXTRACTED_ELIZA   ,y
        iny
        inx
        jmp copy_rest

return_from_extr:
        lda #$00
        sta EXTRACTED_ELIZA   ,y
        ldx #1
        rts

next_char:
        inx
        jmp search_loop

quit_w_no_match:
        ldx #0
        rts


// --------------------------------------------------------------------------------------------------------------

GetResponse:
        ldx #$00            // pattern index x = 0
next_pattern:
        
        jsr matches         // prüfe, ob pattern matcht
        cpx #0
        bne match
no_match:
        lda #0
        sta eliza_answer
        rts
match:
        ldy #$00
        lda $d012
        and #$03
        beq prep_resp0
        cmp #1
        beq prep_resp1
        cmp #2
        beq prep_resp2
prep_resp3:
        lda #ELIZA_QUEST + ELIZA_ANSW *3
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp0:
        lda #ELIZA_QUEST
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp1:
        lda #ELIZA_QUEST + ELIZA_ANSW 
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp2:
        lda #ELIZA_QUEST + ELIZA_ANSW * 2
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response

plot_response:
        lda DATARAM           ,y
        cmp #$30                        // '0' ersetzen mit EXTRACTED            
        bne plot_answer
 
// --- MATCH FOUND ---
        ldx #0
replace_loop:
        lda EXTRACTED_ELIZA,x
        beq continue_with_answer
out_answer_e:
        sta final_answer           
        inc out_answer_e      + 1
        inc out_answer_n      + 1
        inc clean_rest_answer + 1
        inx      
        bne replace_loop
continue_with_answer:
        iny 
plot_answer:  
        lda DATARAM           ,y
        beq return_from_response
out_answer_n:
        sta final_answer 
        inc out_answer_e      + 1
        inc out_answer_n      + 1 
        inc clean_rest_answer + 1       
        iny
        bne plot_response
        inc clean_rest_answer + 1
return_from_response:
        lda #$0
clean_rest_answer:
        sta final_answer
        lda #1 
        sta eliza_answer
        rts

Plot_ELIZA_ANSWER:
         ldx #0
         ldy #0
         sty start_row_eliza      + 1
         sty onRow_eliza
GET_FINAL_ANWER_ELIZA:
         lda final_answer        , y
         cmp #' '
         beq setMark_Eliza
         inx
         iny
         cpy #ANSWER_LENGTH
         bne GET_FINAL_ANWER_ELIZA
         jsr scroll_up
         rts

setMark_Eliza:
         cpx #39
         bcc on_this_row_eliza
          
         lda mark_eliza
         sta curr_mark_eliza +1
         
start_row_eliza:
         ldy #0
         ldx #0
GiveOutRow_Eliza:
         lda final_answer        , y
         beq last_word_eliza
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         iny
curr_mark_eliza:
         cpy #0
         bne GiveOutRow_Eliza
        
         lda #$20
fill_up_eliza:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bcc fill_up_eliza
        
         sty start_row_eliza      + 1

         jsr scroll_up
         
         ldy start_row_eliza + 1
         dey
         ldx #0
         jmp GET_FINAL_ANWER_ELIZA

last_word_eliza:
         lda onRow_eliza
         beq return_from_last_word_eliza

         lda #$20
fill_up_last_eliza:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bcc fill_up_last_eliza

         jsr scroll_up
         jsr ClearLineEliza
         jsr scroll_up
         rts 
return_from_last_word_eliza:
         jsr ClearLineEliza
         jsr scroll_up
         jsr scroll_up
         rts
ClearLineEliza:
         ldx #0
clear_line_eliza:
         lda #$20
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         lda #WHITE
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bne clear_line_eliza
         rts
on_this_row_eliza:
         inc onRow_eliza
         iny
         sty mark_eliza
         inx
         jmp GET_FINAL_ANWER_ELIZA
         rts
onRow_eliza:
 .byte 0
mark_eliza:
 .byte 0
// -------------------------------------------------
// daten
// -------------------------------------------------
fallback:
        .text "please tell me more "
        .byte 0

replaced:
  .byte 0