
/*********************************************************
 *     coded by Adder of Triad in 2026 for X2026         *
 *********************************************************/
#import "variables.src"

.pc = SCROLLING "SCROLL SCREENS"

scroll_up:
    lda #>SCREENS
    clc
    adc #$20                  // 8 screens
    sta LineZero_HI
    sta LineOne_HI

    lda #<SCREENS
    sta LineZero_LO
    sec
    sbc #40
    sta LineOne_LO

    lda LineOne_HI
    sbc #0
    sta LineOne_HI


    lda #>COLORS
    clc
    adc #$20                  // 8 screens
    sta ColorLineZero_HI
    sta ColorLineOne_HI

    lda #<COLORS
    sta ColorLineZero_LO
    sec
    sbc #40
    sta ColorLineOne_LO

    lda ColorLineOne_HI
    sbc #0
    sta ColorLineOne_HI

    ldx #$0
ScrollArea:
    ldy #$0
loop_scroll:
    lda (LineOne_LO) ,y     
    sta (LineZero_LO),y
    lda (ColorLineOne_LO) ,y     
    sta (ColorLineZero_LO),y
    iny
    cpy #40
    bne loop_scroll  

    lda LineOne_LO
    sec
    sbc #40
    sta LineOne_LO
    lda LineOne_HI
    sbc #0
    sta LineOne_HI

    lda LineZero_LO
    sec
    sbc #40
    sta LineZero_LO
    lda LineZero_HI
    sbc #0
    sta LineZero_HI


    lda ColorLineOne_LO
    sec
    sbc #40
    sta ColorLineOne_LO
    lda ColorLineOne_HI
    sbc #0
    sta ColorLineOne_HI

    lda ColorLineZero_LO
    sec
    sbc #40
    sta ColorLineZero_LO
    lda ColorLineZero_HI
    sbc #0
    sta ColorLineZero_HI

    inx 
    cpx #198
    bne ScrollArea 

    inc lines_used

    jsr PlotScreen
    rts



PlotScreen:
    lda #$0
    sta s_to_d           + 1
    sta s_to_d_color     + 1
    lda #$04
    sta s_to_d           + 2
    lda #$d8
    sta s_to_d_color     + 2


    lda #<(SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000))
    sta source_to_dest   + 1
    lda #>(SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000))    
    sta source_to_dest   + 2

    lda #<(COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000))
    sta source_to_dest_color   + 1
    lda #>(COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000))    
    sta source_to_dest_color   + 2

PLOT_SCREEN_HERE:

    ldx #$0
SOURCE_TO_DESTINATION:
    ldy #$0
source_to_dest:
    lda SCREENS         ,y
s_to_d:
    sta $0400           ,y
source_to_dest_color:
    lda COLORS          ,y
s_to_d_color:
    sta $d800           ,y
    
    iny
    cpy #40
    bne source_to_dest

    lda source_to_dest  + 1
    sec
    sbc #40
    sta source_to_dest  + 1
    lda source_to_dest  + 2
    sbc #0
    sta source_to_dest  + 2


    lda s_to_d          + 1
    clc
    adc #40
    sta s_to_d          + 1
    lda s_to_d          + 2
    adc #0
    sta s_to_d          + 2


    lda source_to_dest_color  + 1
    sec
    sbc #40
    sta source_to_dest_color  + 1
    lda source_to_dest_color  + 2
    sbc #0
    sta source_to_dest_color  + 2


    lda s_to_d_color          + 1
    clc
    adc #40
    sta s_to_d_color          + 1
    lda s_to_d_color          + 2
    adc #0
    sta s_to_d_color          + 2
    
    inx 
    cpx #LASTLINE
    bne SOURCE_TO_DESTINATION
    rts


PaintStart:
         ldx #$0
         ldy #$0
         lda #$20
SetScreensClear:
         sta SCREENS      ,x
         lda #WHITE
SetColorClear:
         sta COLORS       ,x
         lda #$20

         inx 
         bne SetScreensClear
         inc SetScreensClear + 2
         inc SetColorClear + 2
         iny
         cpy #SCROLLSCREENS 
         bne SetScreensClear

         ldx #$0
GetTribotLogo:
         lda inrtoduce        ,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*0,x

         lda tribot_plus_logo,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*2,x
         lda tribot_plus_logo + 26,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*3,x
         lda tribot_plus_logo + 26 *2,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*4,x
         lda tribot_plus_logo + 26 *3,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*5,x
         lda tribot_plus_logo + 26 *4,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*6,x
         lda tribot_plus_logo + 26 *5,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*7,x
         lda tribot_plus_logo + 26 *6,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*8,x
         lda tribot_plus_logo + 26 *7,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*9,x

         lda #GREY
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*0,x
         lda tribot_plus_logo + 26*8,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*2,x
         lda tribot_plus_logo + 26*9,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*3,x
         lda tribot_plus_logo + 26*10,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*4,x
         lda tribot_plus_logo + 26*11,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*5,x
         lda tribot_plus_logo + 26*12,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*6,x
         lda tribot_plus_logo + 26*13,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*7,x
         lda tribot_plus_logo + 26*14,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*8,x
         lda tribot_plus_logo + 26*15,x
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*9,x
         inx  
         cpx #26
         bne GetTribotLogo

         ldy #0
PrintInfo:
         ldx #0
Info: 
         lda Infotext,x
info_location:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*11, x
         lda #LIGHT_GREY
info_color:
         sta COLORS  + $2000 - ((SCROLLSCREENS - 1) * 1000) - 40*11, x
         inx
         cpx #40
         bne Info

         lda info_location + 1
         sec
         sbc #40
         sta info_location + 1
         lda info_location + 2
         sbc #0
         sta info_location +2

         lda info_color + 1
         sec
         sbc #40
         sta info_color + 1
         lda info_color + 2
         sbc #0
         sta info_color + 2
         
         lda Info + 1
         clc
         adc #40
         sta Info + 1
         lda Info + 2
         adc #0
         sta Info + 2

         iny 
         cpy #5
         bne PrintInfo

         jsr PlotScreen

         ldx #0 
limiter:
         lda #99
         sta SCREEN - 42   , x
         lda #DARK_GREY
         sta $d800 + 23 *40, x
         inx
         cpx #40
         bne limiter
         rts


PlotAlignedLines:
         ldx #0
         ldy #0
         sty start_row      + 1
         sty onRow
GET_FINAL_ANWER:
         lda BOT_ANSWER_REU        , y
         cmp #' '
         beq setMark
         inx
         iny
         cpy #ANSWER_LENGTH
         bne GET_FINAL_ANWER
         jsr scroll_up
return_from_plot_aligned:
         rts

setMark:
         cpx #39
         bcc on_this_row
          
         lda mark
         sta curr_mark +1
         
start_row:
         ldy #0
         ldx #0
GiveOutRow:
         lda BOT_ANSWER_REU        , y
         beq last_word
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         iny
curr_mark:
         cpy #0
         bne GiveOutRow

         lda #$20
fill_up:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bcc fill_up
        
         sty start_row      + 1

         jsr scroll_up
         
         ldy start_row + 1
         dey
         ldx #0
         jmp GET_FINAL_ANWER

last_word:
         lda onRow
         beq return_from_last_word

         lda #$20
fill_up_last:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bcc fill_up_last

         jsr scroll_up
         jsr ClearLine
         jsr scroll_up
         rts 
return_from_last_word:
         jsr ClearLine
         jsr scroll_up
         rts
ClearLine:
         ldx #0
clear_line:
         lda #$20
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         lda #WHITE
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bne clear_line
         rts
on_this_row:
         inc onRow
         iny
         sty mark
         inx
         jmp GET_FINAL_ANWER
         rts
onRow:
 .byte 0

PlotQuestions:
         ldx #0
GetQ:
         lda SCREEN - 2,x
         beq return_from_question
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         lda #YELLOW
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         jmp GetQ
return_from_question:
         jsr scroll_up
         ldx #0
         lda #$20
clear_row:
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         sta SCREEN,x
         inx
         cpx #40
         bne clear_row
         jsr scroll_up
         ldx #0
think:
         lda thinking,x
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         lda #CYAN
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bne think
return_from_thinking:
         jsr scroll_up     

         ldx #0
possible_color:
         lda #$20
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         lda #WHITE
         sta COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
         inx
         cpx #40
         bne possible_color
         jsr scroll_up        
         rts

scroll_F1:
         lda lines_scrolled
         cmp lines_used
         bcc scrollup
         rts
scrollup:
         inc lines_scrolled
         lda scroll_pos 
         sec
         sbc #40
         sta scroll_pos 
         lda scroll_pos +1
         sbc #0
         sta scroll_pos +1
         jsr PlotScrolledScreen
ret_from_downer:
         rts
scroll_F7:
         lda lines_scrolled
         bne scrolldown
         rts
scrolldown:
         dec lines_scrolled
         lda scroll_pos 
         clc
         adc #40
         sta scroll_pos 
         lda scroll_pos +1
         adc #0
         sta scroll_pos +1
         jsr PlotScrolledScreen
         rts

PlotScrolledScreen:
    lda #$0
    sta s_to_d           + 1
    sta s_to_d_color     + 1
    lda #$04
    sta s_to_d           + 2
    lda #$d8
    sta s_to_d_color     + 2


    lda #<(SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000))
    sec
    sbc scroll_pos       + 0
    sta source_to_dest   + 1
    lda #>(SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000)) 
    sbc scroll_pos       + 1   
    sta source_to_dest   + 2

    lda #<(COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000))
    sec
    sbc scroll_pos             + 0
    sta source_to_dest_color   + 1
    lda #>(COLORS + $2000 - ((SCROLLSCREENS - 1) * 1000))  
    sbc scroll_pos            + 1     
    sta source_to_dest_color  + 2
     
    jsr PLOT_SCREEN_HERE

    rts

save_Y:
  .byte 0

PlotHelp:
    lda #LOCATION_HELP
    sta REUBANK

    lda #<($0100)                      // Die Anzahl der BYTEs ($0100)
    sta REUBYTES                       // je Aktion der REU bekannt machen
    lda #>($0100)
    sta REUBYTES+1

    lda #<HELPSCREENS                        // Beginn des Speichers der  
    sta REUC64RAM                      // REU als C64-Speicherbereich mitteilen
    lda #>HELPSCREENS
    sta REUC64RAM+1

    ldy #0

plot_hlp:
    ldx #0
    sty REURAM + 1

    lda #REU_FETCH_A__            
    sta REUCOMMAND 
getHelp:
    lda HELPSCREENS      ,    x
    sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
getHelpColor:
    lda HELPSCREENS + 128,    x
    sta COLORS  + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
    inx
    cpx #40
    bne getHelp
    
    sty save_Y
    jsr scroll_up
    ldy save_Y

    iny
    cpy #23
    bne plot_hlp
    jsr ClearLine
    rts

PlotInfo:
    lda #LOCATION_HELP
    sta REUBANK

    lda #<($0100)                      // Die Anzahl der BYTEs ($0100)
    sta REUBYTES                       // je Aktion der REU bekannt machen
    lda #>($0100)
    sta REUBYTES+1

    lda #<HELPSCREENS                        // Beginn des Speichers der  
    sta REUC64RAM                      // REU als C64-Speicherbereich mitteilen
    lda #>HELPSCREENS
    sta REUC64RAM+1

    ldy #25
plot_nfo:
    ldx #0
    sty REURAM + 1

    lda #REU_FETCH_A__            
    sta REUCOMMAND 
getInfo:
    lda HELPSCREENS      ,    x
    sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
getInfoColor:
    lda HELPSCREENS + 128,    x
    sta COLORS  + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
    inx
    cpx #40
    bne getInfo
    
    sty save_Y
    jsr scroll_up
    ldy save_Y

    iny
    cpy #48
    bne plot_nfo
    jsr ClearLine
    rts

scroll_pos:
    .byte 0,0


mark:
  .byte 0 
inrtoduce:
  .text "Tribot Plus, Triad                          "

thinking:
  .text "* Thinking...                                                                     "

Infotext:
  .text "This scene database includes embedding  based similarity search and an ELIZA -  style conversational system for simple  natural language interaction.                                      type: /help                                                                                                      "


lines_used:
  .byte 0
lines_scrolled:
  .byte 0

tribot_plus_logo:
.byte 160,160,160,46,254,160,252,46,160,46,254,160,252,46,254,160,252,46,160,160,160,46,32,32,32,32
