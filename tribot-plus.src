/*********************************************************
 *     coded by Adder of Triad in 2026 for X2026         *
 *********************************************************/
#import "tokenize.src"
#import "keyboard_best.src"
#import "embedder.src"
#import "extract.src"
#import "eliza.src"
#import "boot.src"

.pc = $0801 "Basic Upstart"
BasicUpstart(PROGRAMM) 
 
.pc = PROGRAMM "TRIBOT ULTIMATE"
          
          sei
          lda #$7f
          sta $dc0d

          lda #$35
          sta $01
          
          lda #$ff
          cmp $d012
          bne *-3
          lda #$01
          cmp $d012
          bne *-3
          lda #0
          cmp $d012
          bne *-3

          lda #0
          sta $d020
          sta $d021
           
          jsr Init
REU_CHECK:
          jsr checkForREU                    // prüfen ob eine REU vorhanden ist
          cpx #0
          beq REU_CHECK
          
          jsr Init
          jsr CleanUp
          jsr PrintHeadLine_Tribot

          ldx #0
PROMPT:
          lda prompt    ,x
          beq SetNMI
          sta SCREEN - 2,x
          inx
          bne PROMPT
SetNMI:
          lda #<nmi
          sta $fffa
          lda #>nmi
          sta $fffb
         
          lda #<irq
          sta $fffe
          lda #>irq
          sta $ffff

          lda #$a1
          sta $d012
          lda #$1b
          sta $d011
          lda #1
          sta $d019
          sta $d01a
          cli
botloop:   
          jsr Input

          ldx #0
setQuery:
          lda SCREEN,x
          cmp #63 // fragezeichen
          beq finalize_query
sta_input:
          sta string1,x
          inx
          bne setQuery

finalize_query:
          lda #$00
          sta string1,x
          stx len1
          sei
          jsr ExtractString
          
          lda #1
          sta stop_input
      
          jsr worker 
          lda #1
          sta found_answer
          cli
ready:
          jmp botloop                                
                      // zurück
stop_input:
 .byte 0
// ****************************************************************************************
irq: 
         pha
         txa
         pha
         tya
         pha
  
         lda #$9f
         cmp $d012
         bne *-3
         
         lda found_answer
         bne scroll_answer
         
         lda stop_input
         bne returnIrq
     
         jsr if6bc

         lda keyblock 
         beq NormalizedInput

         lda #0
         sta keyblock

NormalizedInput:
         lda inputdone
         bne returnIrq

         inc frame
         lda frame
         cmp #10
         bne returnIrq
        
         lda cursor
         eor #$1
         sta cursor
         
         beq ClearCursor
            
         ldy keypos
         lda #100
         sta SCREEN   ,y
         jmp SetKeyboardBack
ClearCursor:
         ldy keypos
         lda #$20
         sta SCREEN   ,y
SetKeyboardBack:
         lda #0
         sta frame
         sta keyflag
         sta lastkey
        
returnIrq: 
       
         lda #$9e
         sta $d012
         asl $d019
         
         pla
         tay
         pla
         tax
         pla

         rti

        
scroll_answer: 
         lda #$a1
         cmp $d012
         bne *-3
         jsr scrolling

         jmp returnIrq


// ************************************
// ** Worker                         **7
// ************************************
worker:
       /*   lda active_bot
          beq Tribot
          jsr ELIZA
          rts
          */
Tribot:     
          jsr tokenize
          jsr Embeddings
          jsr start_check
          rts

start_check:
  
GETNODES:
          lda reubank
          sta REUBANK
          lda reuram
          sta REURAM + 1

          lda #REU_FETCH_A__           // Befehl fürs Kopieren von der REU zum C64
          sta REUCOMMAND               // mit AUTOLOAD ausführen
           
          jsr cosine_approximation
          cpx #DIM                     // in x - register dot product
          bne check_dist
    
          // found direct hit
          lda reubank
          sta bestBank 
          lda reuram
          sta bestram
          jmp MatchFound
   
diff_bne:  // help jmp
          jmp GETNODES

check_dist:
          cpx dist0
          bcc continue_iterative_search      // carry=1 → a >= b → hier: größer
update_founded:
          stx dist0

set_latest_entry:
          lda reubank
          sta bestBank 
          lda reuram
          sta bestram
  
continue_iterative_search:
          lda reuram
          cmp COUNT_ENTRIES_LO
          beq check_bank
          inc reuram
          bne diff_bne
          inc reubank
          bne diff_bne
          jmp check_founded
check_bank:
          lda reubank
          cmp COUNT_ENTRIES_HI
          beq check_founded
          inc reuram
          bne diff_bne
          inc reubank
          bne diff_bne
          
check_founded:
          lda bestram
          bne MatchFound
          lda bestBank
          bne MatchFound
        
          ldy #0
doPrintNothing:
          lda nothing     ,y
          beq fillUP
          sta final_answer,y
          iny
          bne doPrintNothing
MatchFound: 
          lda bestBank
          sta REUBANK
          lda bestram
          sta REURAM + 1

          lda #REU_FETCH_A__           // Befehl fürs Kopieren von der REU zum C64
          sta REUCOMMAND               // mit AUTOLOAD ausführen
PlotAnswer:
          ldy #0
GET_FINAL_ANWER:
          lda BOT_ANSWER_REU        , y
GiveOutFinal:
          sta final_answer          , y
          iny
          cpy #ANSWER_LENGTH
          bne GET_FINAL_ANWER

fillUP:
          lda #$20
fillup:
          sta final_answer           ,y
          iny
          bne fillup
          rts

CleanUp:
          ldx #0
       
GetLoadLookup:
          lda LoadTab        ,x
SetLookup:
          sta lookUpx127Lo   ,x
          inx  
          bne GetLoadLookup
          inc GetLoadLookup  + 2
          inc SetLookup      + 2
          lda GetLoadLookup  + 2
          cmp #$35
          bne GetLoadLookup
          rts

Init:
          lda #0
          sta keypos
          sta keyflag
          sta keyblock
          sta reuram
          sta reubank
          sta bestBank
          sta bestram
          sta REUBANK                     // 1. Bank (lfd.-Nr. 0)
          sta REURAM                      // und beginnen auch direkt ab Adresse $0000
          sta REURAM+1                    // in der Bank
          sta frame                      
          sta inputdone            
          sta cursor 
          sta stop_input
          sta key_return
          sta musicplay
          sta dist0
          sta check_summe
          sta line_seq

          lda #<DATARAM                      // Beginn des Speichers der  
          sta REUC64RAM                      // REU als C64-Speicherbereich mitteilen
          lda #>DATARAM
          sta REUC64RAM+1

          lda #<($0100)                      // Die Anzahl der BYTEs ($0100)
          sta REUBYTES                       // je Aktion der REU bekannt machen
          lda #>($0100)
          sta REUBYTES+1

          ldx #0     
cls_input:
          lda #$20
          sta SCREEN  ,x
          inx 
          cpx #MAXLENGHT
          bne cls_input

          ldx #0
          lda #0
cls_input_strings:
          sta input   ,x
          sta string1 ,x
          sta correct ,x
          inx
          bne cls_input_strings
          rts

scrolling:
         ldy #0
GetAnswer:
         lda final_answer,                                                      y
         sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , y       
         iny
         cpy #40
         bne GetAnswer
         jsr scroll_up

         lda #0
         sta answer_index
         sta found_answer
         jsr Init
ReturnFromHardScroll:
         rts

line_seq:
 .byte 0

found_answer:
  .byte 0
answer_index:
 .byte 0       
smooth:
    .byte 0

hard_scroll:
 .byte 0

prompt:
   .text "> "
   .byte 0
nmi: 
    rti  

nothing: 
  .text "sorry, i do not understand!"
  .byte 0