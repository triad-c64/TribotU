#import "variables.src"

.var resp_ptr_lo = $f2
.var resp_ptr_hi = $f3

// -------------------------------------------------
// getresponse 6510-asm
// input: $0600
// output: $0700
// patterns: $0800, responses: $0900
// random counter: $00F0
// -------------------------------------------------

.pc = ELIZA "ELIZA"


          lda #128                   // OFFSET ELIZA
          sta REUBANK
eliza_entries:
          lda #0
          sta REURAM + 1

          lda #REU_FETCH_A__            
          sta REUCOMMAND                
            
          jsr GetResponse
          lda eliza_answer
          bne here_wait
          inc eliza_entries + 1
          lda eliza_entries + 1 
          cmp ELIZA_ENTRIES
          bne eliza_entries
          
          lda eliza_answer
          beq fallback_eliza

          jmp here_wait
fallback_eliza:
         
          ldx #$00
copy_fallback:
          lda fallback,x
          sta $0740,x
          inx
          cpx #$13            // 19 bytes
          bne copy_fallback


here_wait:
          jmp here_wait


matches:
        ldx #0          // x = offset im input

search_loop:
        lda string1           ,x
        beq quit_w_no_match    // ende input, kein match
        ldy #0                 // y = offset im pattern
match_pattern:
        lda DATARAM           ,y
        beq pattern_matched   // ende pattern -> match
        cmp #$30
        beq pattern_matched
        lda string1           ,x
        cmp DATARAM           ,y
        bne next_char
        iny
        inx
        jmp match_pattern

pattern_matched:
        // kopiere rest von input in extracted
      //  inx                // start nach pattern
        ldy #0
copy_rest:
        lda string1           ,x
        sta EXTRACTED_ELIZA   ,y
       // sta $0400             ,y
        beq return_from_extr
        iny
        inx
        jmp copy_rest

return_from_extr:
        ldx #1
        rts

next_char:
        inx
        jmp search_loop

quit_w_no_match:
        ldx #0
        rts


// --------------------------------------------------------------------------------------------------------------

GetResponse:
        ldx #$00            // pattern index x = 0
next_pattern:
        
        jsr matches         // prüfe, ob pattern matcht
        cpx #0
        beq no_match


        ldy #$00

        lda $d012
        and #$03
        beq prep_resp0
        cmp #1
        beq prep_resp1
        lda #128 +64
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp0:
        lda #64
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp1:
        lda #128
        sta plot_response + 1
        sta plot_answer   + 1
    

plot_response:
        lda DATARAM + DIM   ,y
        cmp #$30 // '0' ersetzen mit EXTRACTED            
        bne plot_answer
 
// --- MATCH FOUND ---
        ldx #0
replace_loop:
        lda EXTRACTED_ELIZA,x
        beq continue_with_answer
out_answer_e:
        sta $0700           
        inc out_answer_e + 1
        inc out_answer_n + 1
        inx
        cpx #DIM           
        bne replace_loop
continue_with_answer:
        iny 
plot_answer:  
        lda DATARAM + DIM   ,y
        beq return_from_response
out_answer_n:
        sta $0700   
        inc out_answer_e + 1
        inc out_answer_n + 1        
        iny
        bne plot_response
return_from_response:
        lda #1 
        sta eliza_answer
        rts

no_match:
        lda #0
        sta eliza_answer
        rts

// -------------------------------------------------
// daten
// -------------------------------------------------
fallback:
        .text "please tell me more"
        .byte 0
