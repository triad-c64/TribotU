 *********************************************************/
#import "variables.src"
#import "image_routines.src"

.pc = ELIZA "ELIZA"

        lda #0
        sta eliza_entries     + 1
        lda #<final_answer 
        sta out_answer_e      + 1
        sta out_answer_n      + 1
        sta clean_rest_answer + 1

        lda #>final_answer 
        sta out_answer_e      + 2
        sta out_answer_n      + 2
        sta clean_rest_answer + 2

        lda #128                   // OFFSET ELIZA
        sta REUBANK
eliza_entries:
        lda #0
        sta REURAM + 1

        lda #REU_FETCH_A__            
        sta REUCOMMAND                
            
        jsr GetResponse

        lda eliza_answer
        bne here_wait
        inc eliza_entries + 1
        lda eliza_entries + 1 
        cmp ELIZA_ENTRIES
        bne eliza_entries
          
        lda eliza_answer
        beq fallback_eliza

        jmp here_wait
fallback_eliza:
         
        ldy #$00
copy_fallback:
        lda fallback,y
        beq cnup
        sta final_answer,y
        iny
        jmp copy_fallback

cnup:
        lda #$20
clean_rest_bck_answer:
        sta final_answer           ,y
        iny
        bne clean_rest_bck_answer

here_wait:
        rts


matches:
        ldx #0          

search_loop:
        lda string2           ,x
        beq quit_w_no_match     
        ldy #0                 
match_pattern:
        lda DATARAM           ,y
        beq pattern_matched    
        cmp #$30
        beq pattern_matched
        lda string2           ,x
        cmp DATARAM           ,y
        bne next_char
        iny
        inx
        jmp match_pattern

pattern_matched:
        ldy #0
copy_rest:
        lda string2           ,x
        sta EXTRACTED_ELIZA   ,y
        beq return_from_extr
        iny
        inx
        jmp copy_rest

return_from_extr:
        ldx #1
        rts

next_char:
        inx
        jmp search_loop

quit_w_no_match:
        ldx #0
        rts


// --------------------------------------------------------------------------------------------------------------

GetResponse:
        ldx #$00            // pattern index x = 0
next_pattern:
        
        jsr matches         // prüfe, ob pattern matcht
        cpx #0
        bne match
no_match:
        lda #0
        sta eliza_answer
        rts
match:
        ldy #$00

        lda $d012
        and #$03
        beq prep_resp0
        cmp #1
        beq prep_resp1
        cmp #2
        beq prep_resp2
prep_resp3:
        lda #ELIZA_QUEST + ELIZA_ANSW *3
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp0:
        lda #ELIZA_QUEST
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp1:
        lda #ELIZA_QUEST + ELIZA_ANSW 
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response
prep_resp2:
        lda #ELIZA_QUEST + ELIZA_ANSW * 2
        sta plot_response + 1
        sta plot_answer   + 1
        jmp plot_response

plot_response:
        lda DATARAM           ,y
        cmp #$30                        // '0' ersetzen mit EXTRACTED            
        bne plot_answer
 
// --- MATCH FOUND ---
        ldx #0
replace_loop:
        lda EXTRACTED_ELIZA,x
        beq continue_with_answer
out_answer_e:
        sta final_answer           
        inc out_answer_e      + 1
        inc out_answer_n      + 1
        inc clean_rest_answer + 1
        inx
        cpx #DIM           
        bne replace_loop
continue_with_answer:
        iny 
plot_answer:  
        lda DATARAM           ,y
        beq return_from_response
out_answer_n:
        sta final_answer 
        inc out_answer_e      + 1
        inc out_answer_n      + 1 
        inc clean_rest_answer + 1       
        iny
        bne plot_response
return_from_response:
        lda #$20
clean_rest_answer:
        sta final_answer     
        inc clean_rest_answer + 1
        bne clean_rest_answer
        lda #1 
        sta eliza_answer
        rts

Plot_ELIZA_ANSWER:
        ldx #0
plot_eliza_answer:
        lda final_answer,x
        sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
        inx
        cpx #40
        bne plot_eliza_answer

        jsr scroll_up

        ldx #0
plot_eliza_clean:
        lda #$20
        sta SCREENS + $2000 - ((SCROLLSCREENS - 1) * 1000) - (LASTLINE * 40) , x
        inx
        cpx #40
        bne plot_eliza_clean
        
        jsr scroll_up
        rts

// -------------------------------------------------
// daten
// -------------------------------------------------
fallback:
        .text "please tell me more"
        .byte 0
